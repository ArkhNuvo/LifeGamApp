{
  "name": "lifegam",
  "version": "0.4.0",
  "description": "LifeGam - gamify your life",
  "main": "./out/main/index.js",
  "author": "aiarh",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "release:win": "electron-vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.arkhipov.lifegam",
    "productName": "LifeGam",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "ArkhNuvo",
      "repo": "LifeGamApp",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    }
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@hello-pangea/dnd": "^17.0.0",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.3.0",
    "immer": "^11.1.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.1.0",
    "recharts": "^3.9.2",
    "uuid": "^9.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
